# Production Environment Configuration
DEBUG=False
SECRET_KEY=super-secret-production-key-change-me-in-production-123456789
ALLOWED_HOSTS=artify.com,www.artify.com,your-production-domain.com

# Database Configuration
DATABASE_URL=postgresql://artify_user:secure_password@db:5432/artify_prod

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@artify.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Artify <noreply@artify.com>
SERVER_EMAIL=server@artify.com

# File Storage
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
CORS_ALLOWED_ORIGINS=https://artify.com,https://www.artify.com

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Stripe Configuration (Use your production keys)
STRIPE_PUBLIC_KEY=pk_live_your_production_public_key
STRIPE_SECRET_KEY=sk_live_your_production_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# Database Settings
DB_NAME=artify_prod
DB_USER=artify_user
DB_PASSWORD=secure_database_password_123
DB_HOST=db
DB_PORT=5432

# Admin Configuration
ADMIN_PASSWORD=secure_admin_password_123
